---
import { listBookings, listRooms } from "../lib/db";
import { OWNER_COOKIE } from "../lib/owner";
import { SLOTS, addDays, isBookableDate, today } from "../lib/slots";
import "../styles.css";

// A requested date outside the two-week booking window (or not a date at
// all) falls back to today rather than erroring — the page's own nav links
// never produce an out-of-window date, so this only bites a hand-built URL.
const requested = Astro.url.searchParams.get("date");
const date = requested && isBookableDate(requested) ? requested : today();
const prevDate = addDays(date, -1);
const nextDate = addDays(date, 1);
const canGoPrev = prevDate >= today();
const canGoNext = isBookableDate(nextDate);

const rooms = listRooms();
const bookings = listBookings(date);
const bookingFor = (roomId: number, slot: string) =>
  bookings.find((b) => b.roomId === roomId && b.slot === slot);

// Read-only here: whether *this* cell's cancel button renders depends on
// whether the visiting browser's cookie matches the booking's owner token,
// but the cookie itself is only ever minted on a POST — a page view never
// creates one.
const myToken = Astro.cookies.get(OWNER_COOKIE)?.value;

const error = Astro.url.searchParams.get("error");
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Study rooms — {date}</title>
  </head>
  <body>
    <nav aria-label="site">
      <a href="/">Study rooms</a>
      <a href="/mine/">My bookings</a>
      <a href="/search/">Search</a>
      <a href="/readme/">About</a>
    </nav>
    <main>
      <h1>Book a study room</h1>
      <p>
        {rooms.length} rooms, hourly slots, Australia/Canberra time, up to two
        weeks ahead. The library's own room-booking page doesn't show anyone
        else's booking until you reload it, so two groups regularly turn up to
        the same room at the same time. Book here instead and every open tab
        sees a slot go from free to booked the moment it happens — no reload
        needed.
      </p>
      <p>
        No login: booking a slot remembers you with a cookie in this browser,
        which is how a Cancel button shows only on bookings you made here.
        Book and manage from the same browser — a different device, or a
        cleared cookie, won't recognise a booking as yours.
      </p>
      {error === "taken" && <p role="alert">Someone booked that slot just before you did — pick another.</p>}
      {error === "missing" && <p role="alert">Name, room and slot are all required.</p>}
      {error === "date" && <p role="alert">That date isn't bookable — pick one within the next two weeks.</p>}
      {error === "waiting" && <p role="alert">You're already on the waitlist for that slot.</p>}
      <nav aria-label="date">
        {canGoPrev ? (
          <a href={`/?date=${prevDate}`}>&larr; {prevDate}</a>
        ) : (
          <span aria-hidden="true">&larr;</span>
        )}
        <strong>{date}</strong>
        {canGoNext ? (
          <a href={`/?date=${nextDate}`}>{nextDate} &rarr;</a>
        ) : (
          <span aria-hidden="true">&rarr;</span>
        )}
      </nav>
      <div class="grid-wrap">
        <table>
          <caption>Room availability for {date}</caption>
          <thead>
            <tr>
              <th scope="col">Room</th>
              {SLOTS.map((slot) => (
                <th scope="col">{slot}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {rooms.map((room) => (
              <tr>
                <th scope="row">{room.name}</th>
                {SLOTS.map((slot) => {
                  const booking = bookingFor(room.id, slot);
                  const cellId = `${room.id}-${slot}`;
                  return (
                    <td data-room={room.id} data-slot={slot}>
                      {booking ? (
                        <div class="booked">
                          <span>Booked — {booking.bookedBy}</span>
                          {myToken && booking.ownerToken === myToken ? (
                            <form method="post" action={`/api/bookings/${booking.id}/cancel`}>
                              <input type="hidden" name="date" value={date} />
                              <button type="submit">Cancel</button>
                            </form>
                          ) : (
                            <form method="post" action="/api/waitlist" class="waitlist-form">
                              <input type="hidden" name="roomId" value={room.id} />
                              <input type="hidden" name="date" value={date} />
                              <input type="hidden" name="slot" value={slot} />
                              <label for={`wait-${cellId}`} class="sr-only">
                                Your name, to be notified if {room.name} at {slot} frees up
                              </label>
                              <input
                                id={`wait-${cellId}`}
                                name="wantedBy"
                                placeholder="Name"
                                required
                                maxlength="80"
                              />
                              <button type="submit">Join waitlist</button>
                            </form>
                          )}
                        </div>
                      ) : (
                        <form method="post" action="/api/bookings">
                          <input type="hidden" name="roomId" value={room.id} />
                          <input type="hidden" name="date" value={date} />
                          <input type="hidden" name="slot" value={slot} />
                          <label for={`name-${cellId}`} class="sr-only">
                            Your name, for {room.name} at {slot}
                          </label>
                          <input id={`name-${cellId}`} name="bookedBy" placeholder="Name" required maxlength="80" />
                          <button>Book</button>
                        </form>
                      )}
                    </td>
                  );
                })}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </main>
    <script is:inline define:vars={{ date }}>
      // The live half: subscribe to the SSE stream and flip a cell from free
      // to booked the moment anyone books it, in any tab — this is the whole
      // point, since the real library page never does this.
      const source = new EventSource("/api/events");
      source.addEventListener("booking", (event) => {
        const booking = JSON.parse(event.data);
        if (booking.date !== date) return;
        const cell = document.querySelector(
          `td[data-room="${booking.roomId}"][data-slot="${booking.slot}"]`,
        );
        // A cell already showing "Booked" (own cancel button or someone
        // else's waitlist form) means this tab already knows — a waitlist
        // promotion for a slot this tab never saw go free would otherwise
        // stomp on a cell that isn't actually stale.
        if (!cell || cell.querySelector(".booked")) return;
        const div = document.createElement("div");
        div.className = "booked";
        const span = document.createElement("span");
        span.textContent = `Booked — ${booking.bookedBy}`;
        div.append(span);
        cell.replaceChildren(div);
      });
      // The other half of live: a slot someone else cancels frees up in every
      // *other* open tab too, not just on their own next reload. The tab that
      // did the cancelling gets there via its own 303 redirect, same as a
      // fresh booking — this only rebuilds the bookable form for everyone
      // else. Built with createElement/textContent rather than innerHTML: the
      // server doesn't fully control what ends up in booking.slot (nothing
      // stops a hand-built request sending an arbitrary string, see
      // bookings.ts), and this data arrives over SSE from that same table, so
      // treat it the same as any other untrusted string rather than trusting
      // it because it usually looks like "09:00".
      source.addEventListener("cancelled", (event) => {
        const booking = JSON.parse(event.data);
        if (booking.date !== date) return;
        const cell = document.querySelector(
          `td[data-room="${booking.roomId}"][data-slot="${booking.slot}"]`,
        );
        // A free cell's booking form is a direct child of the td; a booked
        // cell's cancel/waitlist form is nested inside its ".booked" div —
        // so ":scope > form" is what "already free in this tab" actually means.
        if (!cell || cell.querySelector(":scope > form")) return; // already free in this tab
        const roomName = cell.closest("tr")?.querySelector("th")?.textContent ?? "this room";
        const cellId = `${booking.roomId}-${booking.slot}`;

        const form = document.createElement("form");
        form.method = "post";
        form.action = "/api/bookings";

        const hidden = (name, value) => {
          const input = document.createElement("input");
          input.type = "hidden";
          input.name = name;
          input.value = value;
          form.append(input);
        };
        hidden("roomId", booking.roomId);
        hidden("date", date);
        hidden("slot", booking.slot);

        const label = document.createElement("label");
        label.htmlFor = `name-${cellId}`;
        label.className = "sr-only";
        label.textContent = `Your name, for ${roomName} at ${booking.slot}`;
        form.append(label);

        const input = document.createElement("input");
        input.id = `name-${cellId}`;
        input.name = "bookedBy";
        input.placeholder = "Name";
        input.required = true;
        input.maxLength = 80;
        form.append(input);

        const button = document.createElement("button");
        button.textContent = "Book";
        form.append(button);

        cell.replaceChildren(form);
      });
    </script>
  </body>
</html>
